# Somente desenvolvimento local. Mesmos dados fictícios do compose.yaml.
BATSINAL_DATABASE_URL=postgresql+psycopg://batsinal:batsinal_dev@127.0.0.1:55432/batsinal
BATSINAL_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Demonstração: libera /api/simulador/leituras e repete as leituras dos sensores simulados.
# Deixe false (padrão) quando os sensores reais enviarem leituras para /api/leituras.
BATSINAL_SIMULADOR=true
# Opcionais (valores padrão):
# BATSINAL_SESSAO_HORAS=168
# BATSINAL_SINAL_EXPIRA_SEGUNDOS=60
# BATSINAL_FUSO_HORARIO=America/Sao_Paulo
# BATSINAL_RETENCAO_HISTORICO_DIAS=14
# BATSINAL_AMOSTRAGEM_SEGUNDOS=10
# Banco usado pelos testes de integração (precisa terminar em _test; é recriado a cada execução):
# BATSINAL_TEST_DATABASE_URL=postgresql+psycopg://batsinal:batsinal_dev@127.0.0.1:55432/batsinal_test

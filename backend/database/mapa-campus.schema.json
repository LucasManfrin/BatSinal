{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mapa do campus BatSinal (MVP)",
  "type": "object",
  "required": [
    "type",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "ponto": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ]
    },
    "linha": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/ponto"
      }
    },
    "anel": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/ponto"
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "type",
        "id",
        "properties",
        "geometry"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "properties": {
          "type": "object",
          "required": [
            "tipo",
            "nome"
          ],
          "properties": {
            "tipo": {
              "enum": [
                "PORTAO",
                "BLOCO",
                "VIA",
                "BOLSAO"
              ]
            },
            "nome": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "estacionamentoId": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "geometry": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "$ref": "#/$defs/ponto"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "LineString"
                },
                "coordinates": {
                  "$ref": "#/$defs/linha"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "Polygon"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/anel"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
